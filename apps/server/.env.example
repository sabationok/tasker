# dev | production — set per hosting environment; picks same-stage dependencies (src/config/env.ts)
STAGE=dev
DATABASE_URL=postgres://localhost/tasker
REDIS_URL=redis://127.0.0.1:6379
# leased from dev-dashboard: dev-dashboard port --port-name api
PORT=3109
BIND_HOST=127.0.0.1

# dev only: accept X-Tasker-Client: <name> from loopback instead of an API key
TRUST_CLIENT_HEADER=false
# CLIENT_HEADER_EVENTS_URL=
